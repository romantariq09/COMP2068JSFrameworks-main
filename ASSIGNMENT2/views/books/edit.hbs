{{> header}}

<div class="row justify-content-center">

    <div class="col-lg-8">

        <div class="card shadow-sm">

            <div class="card-body p-4">

                <h1 class="mb-4">Edit Book</h1>

                <form method="POST" action="/books/{{book._id}}?_method=PUT">

                    <div class="mb-3">
                        <label for="title" class="form-label">
                            Book Title
                        </label>

                        <input
                            type="text"
                            id="title"
                            name="title"
                            class="form-control"
                            value="{{book.title}}"
                            required
                        >
                    </div>

                    <div class="mb-3">
                        <label for="author" class="form-label">
                            Author
                        </label>

                        <input
                            type="text"
                            id="author"
                            name="author"
                            class="form-control"
                            value="{{book.author}}"
                            required
                        >
                    </div>

                    <div class="mb-3">
                        <label for="genre" class="form-label">
                            Genre
                        </label>

                        <input
                            type="text"
                            id="genre"
                            name="genre"
                            class="form-control"
                            value="{{book.genre}}"
                            required
                        >
                    </div>

                    <div class="mb-3">
                        <label for="publicationYear" class="form-label">
                            Publication Year
                        </label>

                        <input
                            type="number"
                            id="publicationYear"
                            name="publicationYear"
                            class="form-control"
                            value="{{book.publicationYear}}"
                        >
                    </div>

                    <div class="mb-3">
                        <label for="isbn" class="form-label">
                            ISBN
                        </label>

                        <input
                            type="text"
                            id="isbn"
                            name="isbn"
                            class="form-control"
                            value="{{book.isbn}}"
                        >
                    </div>

                    <div class="mb-3">
                        <label for="description" class="form-label">
                            Description
                        </label>

                        <textarea
                            id="description"
                            name="description"
                            class="form-control"
                            rows="5"
                        >{{book.description}}</textarea>
                    </div>

                    <div class="mb-3">
                        <label for="availability" class="form-label">
                            Availability
                        </label>

                        <select
                            id="availability"
                            name="availability"
                            class="form-select"
                        >
                            <option value="Available">
                                Available
                            </option>

                            <option value="Unavailable">
                                Unavailable
                            </option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label for="image" class="form-label">
                            Image URL
                        </label>

                        <input
                            type="text"
                            id="image"
                            name="image"
                            class="form-control"
                            value="{{book.image}}"
                        >
                    </div>

                    <button
                        type="submit"
                        class="btn btn-dark"
                    >
                        Update Book
                    </button>

                    <a
                        href="/books"
                        class="btn btn-outline-secondary"
                    >
                        Cancel
                    </a>

                </form>

            </div>

        </div>

    </div>

</div>

{{> footer}}