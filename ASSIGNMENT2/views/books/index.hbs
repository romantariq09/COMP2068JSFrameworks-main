{{> header}}

<h1 class="mb-4">Book Collection</h1>

<form method="GET" action="/books" class="mb-4">

    <div class="input-group">

        <input
            type="text"
            name="search"
            class="form-control"
            placeholder="Search by title or author"
            value="{{search}}"
        >

        <button class="btn btn-dark" type="submit">
            Search
        </button>

    </div>

    {{#if search}}
        <div class="mt-2">
            <a href="/books">Clear Search</a>
        </div>
    {{/if}}

</form>

{{#if currentUser}}

    <a href="/books/add" class="btn btn-primary mb-4">
        + Add New Book
    </a>

{{/if}}


{{#if books.length}}

    <div class="row">

        {{#each books}}

           <div class="col-md-6 col-lg-4 mb-4">

    <div class="card h-100 shadow-sm">

        {{#if this.image}}
            <img
                src="{{this.image}}"
                class="book-image"
                alt="{{this.title}}"
            >
        {{/if}}

        <div class="card-body">

            <h4 class="card-title">
                {{this.title}}
            </h4>

            <p>
                <strong>Author:</strong>
                {{this.author}}
            </p>

            <p>
                <strong>Genre:</strong>
                {{this.genre}}
            </p>

            {{#if this.publicationYear}}
                <p>
                    <strong>Year:</strong>
                    {{this.publicationYear}}
                </p>
            {{/if}}

            {{#if this.isbn}}
                <p>
                    <strong>ISBN:</strong>
                    {{this.isbn}}
                </p>
            {{/if}}

            {{#if this.description}}
                <p class="text-muted">
                    {{this.description}}
                </p>
            {{/if}}

            <p>
                <strong>Availability:</strong>

                {{#if this.availability}}
                    {{this.availability}}
                {{/if}}
            </p>

            {{#if ../currentUser}}

                <a
                    href="/books/{{this._id}}/edit"
                    class="btn btn-outline-primary"
                >
                    Edit
                </a>

                <form
                    method="POST"
                    action="/books/{{this._id}}?_method=DELETE"
                    class="d-inline"
                    onsubmit="return confirm('Are you sure you want to delete this book?');"
                >
                    <button
                        type="submit"
                        class="btn btn-outline-danger"
                    >
                        Delete
                    </button>
                </form>

            {{/if}}

        </div>

    </div>

</div>

        {{/each}}

    </div>

{{else}}

    <div class="alert alert-info">
        No books found.
    </div>

{{/if}}

{{> footer}}