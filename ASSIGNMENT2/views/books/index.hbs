<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{{title}} | BookNest</title>
</head>

<body>

    <h1>Book Collection</h1>

    <a href="/books/add">Add New Book</a>

<br><br>

    {{#if books.length}}

        {{#each books}}

            <div>
                <h2>{{this.title}}</h2>

                <p>
                    <strong>Author:</strong>
                    {{this.author}}
                </p>

                <p>
                    <strong>Genre:</strong>
                    {{this.genre}}
                </p>

                <p>
                    <strong>Availability:</strong>
                    {{this.availability}}
                </p>
            </div>

        {{/each}}

    {{else}}

        <p>No books found.</p>

    {{/if}}

</body>
</html>