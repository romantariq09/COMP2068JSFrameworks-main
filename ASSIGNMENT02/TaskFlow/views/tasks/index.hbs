<h1>{{title}}</h1>

<p>
  Browse tasks shared on TaskFlow. Use the search and filters to find tasks
  more quickly.
</p>

<form class="filter-form" action="/tasks" method="GET">
  <div>
    <label for="search">Search by Task Title</label><br />
    <input
      type="text"
      id="search"
      name="search"
      value="{{search}}"
      placeholder="For example: Assignment"
    />
  </div>

  <br />

  <div>
    <label for="category">Category</label><br />
    <select id="category" name="category">
      <option value="" {{#if isAllCategories}}selected{{/if}}>All Categories</option>
      <option value="School" {{#if isSchool}}selected{{/if}}>School</option>
      <option value="Work" {{#if isWork}}selected{{/if}}>Work</option>
      <option value="Personal" {{#if isPersonal}}selected{{/if}}>Personal</option>
    </select>
  </div>

  <br />

  <div>
    <label for="priority">Priority</label><br />
    <select id="priority" name="priority">
      <option value="" {{#if isAllPriorities}}selected{{/if}}>All Priorities</option>
      <option value="Low" {{#if isLow}}selected{{/if}}>Low</option>
      <option value="Medium" {{#if isMedium}}selected{{/if}}>Medium</option>
      <option value="High" {{#if isHigh}}selected{{/if}}>High</option>
    </select>
  </div>

  <br />

  <div>
    <label for="status">Status</label><br />
    <select id="status" name="status">
      <option value="" {{#if isAllStatuses}}selected{{/if}}>All Statuses</option>
      <option value="To Do" {{#if isToDo}}selected{{/if}}>To Do</option>
      <option value="In Progress" {{#if isInProgress}}selected{{/if}}>In Progress</option>
      <option value="Completed" {{#if isCompleted}}selected{{/if}}>Completed</option>
    </select>
  </div>

  <br />

  <button type="submit">Apply Filters</button>
  <a class="clear-link" href="/tasks">Clear Filters</a>
</form>

{{#if tasks}}
  <table>
    <thead>
      <tr>
        <th>Task</th>
        <th>Category</th>
        <th>Due Date</th>
        <th>Priority</th>
        <th>Status</th>
      </tr>
    </thead>

    <tbody>
      {{#each tasks}}
        <tr>
          <td>
            <strong>{{this.title}}</strong>

            {{#if this.description}}
              <br />
              <small>{{this.description}}</small>
            {{/if}}
          </td>
          <td>{{this.category}}</td>
          <td>{{this.dueDate}}</td>
          <td>{{this.priority}}</td>
          <td>{{this.status}}</td>
        </tr>
      {{/each}}
    </tbody>
  </table>
{{else}}
  <p>No tasks match your current search or filters.</p>
{{/if}}